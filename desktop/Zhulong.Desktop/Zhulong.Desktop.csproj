<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zhulong</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <Compile Include="../../prototypes/p0-ai/CodexParser.cs" Link="AI/CodexParser.cs" />
    <Compile Include="../../prototypes/p0-ai/CodexScanner.cs" Link="AI/CodexScanner.cs" />
    <Compile Include="../../prototypes/p0-ai/CodexSessionSnapshots.cs" Link="AI/CodexSessionSnapshots.cs" />
    <Compile Include="../../prototypes/p0-ai/UsageModels.cs" Link="AI/UsageModels.cs" />
    <Compile Include="../../prototypes/p0-ai/UsageStore.cs" Link="AI/UsageStore.cs" />
  </ItemGroup>
</Project>
